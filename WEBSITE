            object-fit: cover;
            transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        /* Entrance Animations */
        .reveal-element {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.8s ease-out, transform 0.8s ease-out;
        }
        .reveal-element.visible {
            opacity: 1;
            transform: translateY(0);
        }

        @media (prefers-reduced-motion: no-preference) {
            /* Ambient Motion */
            @keyframes float {
                0%, 100% { transform: translateY(0); }
                50% { transform: translateY(-15px); }
            }
            .floating-image {
                animation: float 6s ease-in-out infinite;
            }

            @keyframes pulse-accent {
                0%, 100% { opacity: 1; }
                50% { opacity: 0.7; text-shadow: 0 0 10px rgba(221, 183, 255, 0.4); }
            }
            .pulse-text {
                animation: pulse-accent 4s ease-in-out infinite;
            }

            @keyframes shimmer {
                0% { background-position: -200% center; }
                100% { background-position: 200% center; }
            }
            .shimmer-button {
                background-size: 200% auto;
                background-image: linear-gradient(90deg, #b76dff 0%, #ddb7ff 50%, #b76dff 100%);
                transition: transform 0.3s ease;
            }
            .shimmer-button:hover {
                animation: shimmer 2s linear infinite;
                transform: translateY(-2px);
            }
        }

        /* Nav Link Underline */
        .nav-link {
            position: relative;
        }
        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 0;
            height: 2px;
            background: #ddb7ff;
            transition: width 0.3s ease;
        }
        .nav-link:hover::after {
            width: 100%;
        }

        /* Cert Card Interactions */
        .cert-card {
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .cert-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(183, 109, 255, 0.2);
            background: rgba(23, 31, 51, 0.8);
        }
        .cert-card:hover img {
            transform: scale(1.08);
        }

        /* Cursor Glow Effect */
        .cursor-glow {
            position: fixed;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(183, 109, 255, 0.08) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
            transform: translate(-50%, -50%);
            display: none;
        }
        @media (min-width: 1024px) {
            .cursor-glow { display: block; }
        }
    </style>
